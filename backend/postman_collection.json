              "raw": "{\n  \"status\": \"sent\",\n  \"channel\": \"whatsapp\",\n  \"note\": \"Pesan pengingat dikirim via WhatsApp Web\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reminders/1", "host": ["{{baseUrl}}"], "path": ["reminders", "1"] }
          }
        },
        {
          "name": "Get Follow-Up Message & Templates with wa.me Link",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/reminders/1/message", "host": ["{{baseUrl}}"], "path": ["reminders", "1", "message"] }
          }
        }
      ]
    },
    {
      "name": "5. Logika Prioritas & Inference API",
      "item": [
