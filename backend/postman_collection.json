          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/inference/priority/1", "host": ["{{baseUrl}}"], "path": ["inference", "priority", "1"] }
